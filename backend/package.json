{
  "name": "shopping-list-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npx nest build",
    "dev": "npx nest start --watch",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:check:data-api-lockdown": "TS_NODE_PROJECT=tsconfig.json TS_NODE_TRANSPILE_ONLY=true node -r ts-node/register src/database/run-data-api-lockdown.ts --check",
    "migration:run:data-api-lockdown": "TS_NODE_PROJECT=tsconfig.json TS_NODE_TRANSPILE_ONLY=true node -r ts-node/register src/database/run-data-api-lockdown.ts",
    "migration:check:eden": "TS_NODE_PROJECT=tsconfig.json TS_NODE_TRANSPILE_ONLY=true node -r ts-node/register src/database/run-eden-migrations.ts --check",
    "migration:run:eden": "TS_NODE_PROJECT=tsconfig.json TS_NODE_TRANSPILE_ONLY=true node -r ts-node/register src/database/run-eden-migrations.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "test": "TS_NODE_PROJECT=tsconfig.json TS_NODE_TRANSPILE_ONLY=true node -r ts-node/register --test test/*.test.cjs",
    "test:migrations": "TS_NODE_PROJECT=tsconfig.json TS_NODE_TRANSPILE_ONLY=true node -r ts-node/register test/migrations.cjs",
    "test:operation-migrations": "TS_NODE_PROJECT=tsconfig.json TS_NODE_TRANSPILE_ONLY=true node -r ts-node/register test/operations-migration.cjs",
    "test:operations": "TS_NODE_PROJECT=tsconfig.json TS_NODE_TRANSPILE_ONLY=true node -r ts-node/register test/operations-postgres.cjs",
    "test:data-api-lockdown": "TS_NODE_PROJECT=tsconfig.json TS_NODE_TRANSPILE_ONLY=true node -r ts-node/register --test test/data-api-lockdown.cjs",
    "test:eden-migrations": "TS_NODE_PROJECT=tsconfig.json TS_NODE_TRANSPILE_ONLY=true node -r ts-node/register --test --test-concurrency=1 test/eden-migrations-runner.cjs",
    "test:existing-tables-lockdown": "TS_NODE_PROJECT=tsconfig.json TS_NODE_TRANSPILE_ONLY=true node -r ts-node/register --test test/existing-tables-lockdown.cjs",
    "test:supabase-lockdown": "TS_NODE_PROJECT=tsconfig.json TS_NODE_TRANSPILE_ONLY=true node -r ts-node/register --test --test-concurrency=1 test/supabase-lockdown.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/typeorm": "^10.0.2",
    "@supabase/supabase-js": "^2.39.3",
    "@types/pdf-parse": "^1.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "openai": "^6.44.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.19",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^9.0.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
